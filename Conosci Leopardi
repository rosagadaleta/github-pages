<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Frasi di Leopardi</title>
  <style>
    body {
      font-family: Georgia, serif;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100vh;
      background-color: #f4f4f4;
      text-align: center;
      padding: 20px;
    }
    h1 {
      font-size: 1.5rem;
      margin-bottom: 1rem;
    }
    p {
      font-size: 1.2rem;
      color: #333;
    }
  </style>
</head>
<body>
  <h1>La tua frase di Leopardi</h1>
  <p id="frase"></p>
  <p id="profilo"></p>

  <script>
    const frasi = [
      {
        testo: "Sempre caro mi fu quest’ermo colle...",
        tipo: "per chi ama la solitudine e la contemplazione"
      },
      {
        testo: "Passero solitario, alla campagna...",
        tipo: "per chi si sente diverso dagli altri"
      },
      {
        testo: "Dolce e chiara è la notte e senza vento...",
        tipo: "per i sognatori notturni"
      },
      {
        testo: "Che fai tu, luna, in ciel? dimmi, che fai...",
        tipo: "per chi cerca risposte nell’universo"
      },
      {
        testo: "Natura umana, il tuo destin m’è noto...",
        tipo: "per gli spiriti profondi e riflessivi"
      },
      {
        testo: "Il naufragar m’è dolce in questo mare.",
        tipo: "per chi trova pace nell’abbandono alle emozioni"
      },
      {
        testo: "E il cuore ride pur sentendo il pianto.",
        tipo: "per chi sa vedere la luce anche nel dolore"
      },
      {
        testo: "Oimè, quante volte io mi son chiesto...",
        tipo: "per gli eterni domandatori"
      },
      {
        testo: "Vaghe stelle dell’Orsa, io non credea...",
        tipo: "per gli amanti dei cieli stellati"
      },
      {
        testo: "Ahi quanto è vano il cor dell’uom!",
        tipo: "per chi ha sofferto e imparato"
      },
      // ... qui continuano le altre 40+ frasi
    ];

    // Aggiungiamo altre frasi fino a 50
    for (let i = frasi.length + 1; i <= 50; i++) {
      frasi.push({
        testo: `Frase poetica ${i} di Leopardi...`,
        tipo: `per la persona numero ${i}`
      });
    }

    const scelta = frasi[Math.floor(Math.random() * frasi.length)];
    document.getElementById("frase").textContent = scelta.testo;
    document.getElementById("profilo").textContent = scelta.tipo;
  </script>
</body>
</html>
